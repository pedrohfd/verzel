{
	"name": "ticket",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/node": "^22.20.1",
			"tsx": "^4.23.1",
			"better-auth": "1.6.27",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @verzel/db --",
		"db:studio": "turbo run db:studio -F @verzel/db --",
		"db:generate": "turbo run db:generate -F @verzel/db --",
		"db:migrate": "turbo run db:migrate -F @verzel/db --",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@verzel/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "catalog:",
		"@verzel/config": "workspace:*",
		"@vitest/coverage-v8": "4.1.11",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"tsx": "catalog:",
		"turbo": "^2.10.7",
		"typescript": "catalog:",
		"vercel": "^58.1.0",
		"vitest": "4.1.11"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.8"
}
