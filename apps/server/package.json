{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"pretest": "tsx scripts/migrate-test-db.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@verzel/auth": "workspace:*",
		"@verzel/db": "workspace:*",
		"@verzel/env": "workspace:*",
		"@verzel/shared": "workspace:*",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.10.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/pg": "8.23.1",
		"@verzel/config": "workspace:*",
		"@vitest/coverage-v8": "4.1.11",
		"pg": "8.23.0",
		"tsdown": "^0.22.14",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "4.1.11"
	}
}
