{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"web": {
			"root": "apps/web",
			"framework": "vite",
			"installCommand": "cd ../.. && bun install",
			"buildCommand": "VITE_SERVER_URL=/api bun run build",
			"rewrites": [
				{
					"source": "/(.*)",
					"destination": "/index.html"
				}
			]
		},
		"server": {
			"root": "apps/server",
			"framework": "fastify",
			"entrypoint": "src/index.ts",
			"installCommand": "cd ../.. && bun install",
			"buildCommand": "cd ../../packages/db && bun run db:migrate:deploy && cd ../../apps/server && bun run build"
		}
	},
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": {
				"service": "server"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "web"
			}
		}
	]
}
